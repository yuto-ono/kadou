{
	"name": "kadou",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
		"build": "vite build",
		"start": "HOST=127.0.0.1 node --env-file-if-exists=.env build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@types/node": "26.6.1",
		"eslint": "10.10.0",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.12.0",
		"svelte": "5.57.0",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0",
		"vite": "8.3.0",
		"vitest": "5.0.1"
	}
}
